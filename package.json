{
  "name": "marginalia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ensure:native": "pnpm --filter @marginalia/pi-server run ensure:native",
    "predev": "pnpm run ensure:native",
    "dev": "pnpm --filter @marginalia/pi-server build && concurrently -k -n server,desktop \"pnpm --filter @marginalia/pi-server build --watch\" \"pnpm --filter @marginalia/desktop dev\"",
    "build": "pnpm -r build",
    "package": "pnpm --filter @marginalia/desktop package",
    "dist": "pnpm --filter @marginalia/desktop dist",
    "pretest": "pnpm run ensure:native",
    "test:docs": "node --test scripts/docs-check.test.mjs",
    "test": "pnpm run test:docs && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "docs:check": "node scripts/docs-check.mjs",
    "verify": "pnpm docs:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:screenshots": "pnpm --filter @marginalia/desktop verify:screenshots",
    "verify:screenshots:live": "pnpm --filter @marginalia/desktop verify:screenshots:live",
    "verify:screenshots:shot": "pnpm --filter @marginalia/desktop verify:screenshots:shot",
    "verify:visual": "pnpm --filter @marginalia/desktop verify:visual",
    "lint": "eslint apps packages scripts",
    "format": "prettier --write \"*.{md,json,js,mjs,cjs}\" \"pnpm-workspace.yaml\" \"{apps,packages}/**/*.{ts,tsx,css,json}\" \"scripts/**/*.{mjs,json}\" \"docs/{README.md,internal/README.md}\" \"docs/{product,user,developer,superpowers,contracts}/**/*.{md,json}\" \".github/**/*.{md,yml,yaml}\"",
    "format:check": "prettier --check \"*.{md,json,js,mjs,cjs}\" \"pnpm-workspace.yaml\" \"{apps,packages}/**/*.{ts,tsx,css,json}\" \"scripts/**/*.{mjs,json}\" \"docs/{README.md,internal/README.md}\" \"docs/{product,user,developer,superpowers,contracts}/**/*.{md,json}\" \".github/**/*.{md,yml,yaml}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.60.0"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.19.0"
  }
}
