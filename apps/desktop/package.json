{
  "name": "@marginalia/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.node.json && concurrently -k -n vite,electron \"vite --host 127.0.0.1\" \"sh -c 'until curl -sf http://127.0.0.1:5173 >/dev/null; do sleep 0.2; done; VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist-electron/main.js'\"",
    "build": "tsc -p tsconfig.node.json && vite build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@marginalia/chat-core": "workspace:*",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/geist-sans": "^5.2.5",
    "@pierre/trees": "^1.0.0-beta",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "cmdk": "^1.1.1",
    "electron": "^33.2.1",
    "highlight.js": "^11",
    "lucide-react": "^0.460",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^5.7.284",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9",
    "remark-gfm": "^4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2",
    "vite": "^5.4.11",
    "zustand": "^4.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/highlight.js": "^10",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10",
    "jsdom": "^25.0.1",
    "playwright": "^1.60.0",
    "postcss": "^8",
    "tailwindcss": "^3.4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
