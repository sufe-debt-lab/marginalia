{
  "name": "@marginalia/pi-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "scripts/ensure-native-abi.mjs"
  ],
  "scripts": {
    "ensure:native": "node scripts/ensure-native-abi.mjs",
    "check:native": "node scripts/ensure-native-abi.mjs --check-only",
    "dev": "pnpm run ensure:native && tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node scripts/ensure-native-abi.mjs --check-only && node dist/index.js",
    "pretest": "pnpm run ensure:native",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.75.5",
    "@earendil-works/pi-coding-agent": "0.75.5",
    "@hono/node-server": "^1.13.8",
    "@marginalia/chat-core": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "diff": "8.0.4",
    "hono": "^4.6.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.0"
  }
}
